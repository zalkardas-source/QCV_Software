# Copy this file to .env and fill in real values.
# NEVER commit your real .env file.

# Secret used to sign JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_long_random_string

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Optional overrides (defaults are usually fine)
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# DATABASE_URL=sqlite:///./backend/data/qcv_app.db

# Allowed frontend origins (comma-separated in production, e.g. https://qcv.quatelio.com)
# CORS_ALLOWED_ORIGINS=["http://localhost:8000"]
